PORT=3000
JWT_SECRET=change_me
REFRESH_TOKEN_SECRET=change_me
CLIENT_ORIGIN=https://your-frontend.up.railway.app

# Set by Railway Postgres plugin (reference as ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:password@host:5432/livechat

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/livechat

# Set by Railway Redis plugin (reference as ${{Redis.REDIS_URL}})
REDIS_URL=redis://user:password@host:6379

# External TURN service (e.g. Metered, Twilio, Cloudflare Calls)
TURN_URL=turn:your-turn-host:3478
TURN_USERNAME=
TURN_CREDENTIAL=
