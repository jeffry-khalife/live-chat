generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  pseudo     String   @unique
  email      String   @unique
  password   String
  role       Role     @default(client)
  created_at DateTime @default(now())

  @@map("users")
}

enum Role {
  admin
  client
}