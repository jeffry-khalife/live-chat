generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int            @id @default(autoincrement())
  pseudo                  String         @unique
  email                   String         @unique
  password                String
  role                    Role           @default(client)
  refresh_token  String?
  created_at              DateTime       @default(now())
  owned_servers           Server[]       @relation("OwnedServers")
  memberships             ServerMember[]
  conversations_as_first  Conversation[] @relation("ConversationUserOne")
  conversations_as_second Conversation[] @relation("ConversationUserTwo")

  @@map("users")
}

model Server {
  id         Int            @id @default(autoincrement())
  name       String
  icon_url   String?
  owner_id   Int
  created_at DateTime       @default(now())
  owner      User           @relation("OwnedServers", fields: [owner_id], references: [id])
  channels   Channel[]
  members    ServerMember[]

  @@map("servers")
}

model Channel {
  id         Int         @id @default(autoincrement())
  name       String
  type       ChannelType @default(text)
  server_id  Int
  created_at DateTime    @default(now())
  server     Server      @relation(fields: [server_id], references: [id], onDelete: Cascade)

  @@map("channels")
}

model ServerMember {
  user_id   Int
  server_id Int
  role      ServerMemberRole @default(member)
  joined_at DateTime         @default(now())
  user      User             @relation(fields: [user_id], references: [id])
  server    Server           @relation(fields: [server_id], references: [id], onDelete: Cascade)

  @@id([user_id, server_id])
  @@map("server_members")
}

model Conversation {
  id           Int      @id @default(autoincrement())
  user_one_id  Int
  user_two_id  Int
  created_at   DateTime @default(now())
  userOne      User     @relation("ConversationUserOne", fields: [user_one_id], references: [id])
  userTwo      User     @relation("ConversationUserTwo", fields: [user_two_id], references: [id])

  @@unique([user_one_id, user_two_id])
  @@map("conversations")
}

enum Role {
  admin
  client
}

enum ChannelType {
  text
  voice
}

enum ServerMemberRole {
  admin
  member
}